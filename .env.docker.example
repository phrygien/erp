APP_NAME="CosmaERP"
APP_ENV=local
APP_KEY=base64:EnU+gYyDGcUqutvbF5Zsy07jhCKmg8wpOLZeAOv/UIg=
APP_DEBUG=true
APP_URL=https://${APP_DOMAIN}

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ---- Base de données : PostgreSQL + pgvector (service "postgres") ----
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=cosmaerp
DB_USERNAME=cosmaerp
DB_PASSWORD=change-me

# ---- Session / cache / queue : Redis (service "redis") ----
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=change-me
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail.gandi.net
MAIL_PORT=587
MAIL_USERNAME=webmaster@auctav.com
MAIL_PASSWORD="42Jk0H)_<4Y4"
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="webmaster@auctav.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================================
# ---- Domaines exposés via Traefik ----
# ============================================================
APP_DOMAIN=erp.astucom.com
PGADMIN_DOMAIN=pgadmin.astucom.com
KAFKA_UI_DOMAIN=kafka.astucom.com
TYPESENSE_DOMAIN=search.astucom.com

# ---- pgAdmin ----
PGADMIN_EMAIL=admin@cosmaerp.com
PGADMIN_PASSWORD=change-me

# ---- Kafka ----
KAFKA_BROKERS=kafka:9092

# ---- Typesense (service "typesense") ----
